
    <Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot - South Africa"
        Height="650" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- HEADER with Title -->
        <Border Grid.Row="0" Background="#0f3460" Padding="15">
            <StackPanel>
                <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                           FontSize="22" 
                           FontWeight="Bold"
                           Foreground="#e94560" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Your Personal Online Safety Assistant"
                           FontSize="14" 
                           Foreground="#cccccc" 
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
                <TextBlock Text="South Africa Edition"
                           FontSize="12" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- CHAT DISPLAY AREA -->
        <ScrollViewer Grid.Row="1" 
                      x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1a1a2e">
            <StackPanel x:Name="ChatPanel" Margin="10" />
        </ScrollViewer>
        
        <!-- INPUT AREA -->
        <Border Grid.Row="2" Background="#16213e" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="UserInputTextBox"
                         Grid.Column="0"
                         FontSize="14"
                         Padding="10"
                         Background="#1a1a2e"
                         Foreground="White"
                         BorderBrush="#e94560"
                         BorderThickness="1"
                         KeyDown="UserInputTextBox_KeyDown"/>
                
                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        FontSize="14"
                        FontWeight="Bold"
                        Width="60"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>